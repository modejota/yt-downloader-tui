{
  "name": "yt-downloader-tui",
  "private": true,
  "license": "MIT",
  "type": "module",
  "module": "src/index.tsx",
  "scripts": {
    "dev": "bun --watch src/index.tsx",
    "start": "bun src/index.tsx",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun scripts/build.ts",
    "build:linux-x64": "bun scripts/build.ts linux-x64",
    "build:linux-arm64": "bun scripts/build.ts linux-arm64",
    "build:windows-x64": "bun scripts/build.ts windows-x64",
    "build:macos-x64": "bun scripts/build.ts darwin-x64",
    "build:macos-arm64": "bun scripts/build.ts darwin-arm64",
    "build:all": "bun scripts/build.ts all"
  },
  "dependencies": {
    "@mediabunny/aac-encoder": "1.55.1",
    "@mediabunny/flac-encoder": "1.55.1",
    "@mediabunny/mp3-encoder": "1.55.1",
    "@mediabunny/server": "1.55.1",
    "@opentui/core": "0.5.4",
    "@opentui/react": "0.5.4",
    "check-disk-space": "3.4.0",
    "i18next": "26.4.0",
    "mediabunny": "1.55.1",
    "react": "19.2.8",
    "react-i18next": "17.0.12",
    "valibot": "1.4.2",
    "youtubei.js": "18.0.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "19.2.18",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0"
  },
  "peerDependencies": {
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "node-av"
  ]
}
